# Скопируй этот файл в .env и впиши свои значения. Файл .env никому не показывай.

# Токен от @BotFather
BOT_TOKEN=

# Канал, на который нужно быть подписанным. Бот должен быть АДМИНИСТРАТОРОМ этого канала
CHANNEL=@your_channel

# Адрес страницы с календарём (папка advent-app, выложенная в интернет), только https
WEBAPP_URL=https://example.com/

# Во сколько присылать «Окошко открыто» и в каком часовом поясе
REMINDER_TIME=09:00
TZ_NAME=Europe/Moscow
